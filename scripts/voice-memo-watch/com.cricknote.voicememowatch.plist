<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cricknote.voicememowatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>REPLACE/WITH/ABSOLUTE/PATH/TO/watch.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>7200</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/tmp/cricknote-voice-memo-watch.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/cricknote-voice-memo-watch.stderr.log</string>
</dict>
</plist>
